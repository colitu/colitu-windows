<Window
    x:Class="v2rayN.Views.ColituMainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:v2rayN.Views"
    xmlns:s="clr-namespace:v2rayN.Services"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    Title="Colitu VPN"
    Width="1140"
    Height="760"
    MinWidth="1000"
    MinHeight="680"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{StaticResource ColituFont}"
    Foreground="#F4F3FA"
    Icon="/Resources/colitu.ico"
    ResizeMode="CanResize"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="64"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <Geometry x:Key="IconPower">M12 3v8 M6.3 6.7a8 8 0 1 0 11.4 0</Geometry>
            <Geometry x:Key="IconChevron">M9 5l7 7-7 7</Geometry>
            <Geometry x:Key="IconSearch">M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14z M20 20l-4-4</Geometry>
            <Geometry x:Key="IconBolt">M13 2L4.5 13.5H12L11 22l8.5-11.5H12z</Geometry>
            <Geometry x:Key="IconCheck">M5 12.5l4.5 4.5L19 7.5</Geometry>
            <Geometry x:Key="IconLock">M6 11h12v10H6z M8.5 11V8a3.5 3.5 0 0 1 7 0v3</Geometry>
            <Geometry x:Key="IconDevice">M3 5h18v11H3z M8 20h8 M12 16v4</Geometry>
            <Geometry x:Key="IconX">M6 6l12 12 M18 6L6 18</Geometry>
            <Geometry x:Key="IconMinus">M5 12h14</Geometry>
            <Geometry x:Key="IconPlus">M12 5v14 M5 12h14</Geometry>
            <Geometry x:Key="IconEye">M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z</Geometry>
            <Geometry x:Key="IconDownload">M12 4v11 M7 10l5 5 5-5 M5 20h14</Geometry>
            <Geometry x:Key="IconShield">M12 2.5L4.5 5.5v6c0 5 3.3 9 7.5 10.5 4.2-1.5 7.5-5.5 7.5-10.5v-6z</Geometry>
            <Geometry x:Key="IconChat">M4.5 5h15a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5H10l-5 4v-4H4.5A1.5 1.5 0 0 1 3 15.5v-9A1.5 1.5 0 0 1 4.5 5z M8 10h8 M8 13h5</Geometry>
            <Geometry x:Key="IconMail">M3.5 5.5h17v13h-17z M3.5 6.5l8.5 6.5 8.5-6.5</Geometry>
            <Geometry x:Key="IconClip">M20.5 11.5l-8.2 8.2a5 5 0 0 1-7.1-7.1l8.6-8.6a3.3 3.3 0 0 1 4.7 4.7l-8.6 8.6a1.7 1.7 0 0 1-2.4-2.4l7.9-7.9</Geometry>
            <Geometry x:Key="IconSend">M21 3L10.5 13.5 M21 3l-6.5 18-4-7.5-7.5-4z</Geometry>
            <Geometry x:Key="IconFile">M6.5 3h7.5l4.5 4.5V21h-12z M14 3v4.5h4.5</Geometry>
            <Geometry x:Key="IconBook">M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5</Geometry>

            <Style x:Key="Stroke" TargetType="Path">
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
                <Setter Property="StrokeThickness" Value="1.8" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
            </Style>

            <!-- Round flag: the country's SVG clipped to a circle. -->
            <DataTemplate x:Key="FlagTemplate">
                <Grid Width="34" Height="34">
                    <Ellipse Fill="{StaticResource IconWellBrush}" />
                    <Grid Width="34" Height="34" Visibility="{Binding FlagVisibility}">
                        <Grid.Clip>
                            <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" />
                        </Grid.Clip>
                        <!-- The flags are square (flag-icons 1x1), so they fill the circle as is. -->
                        <svgc:SvgViewbox Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding FlagUri}" Stretch="Uniform" />
                    </Grid>
                    <Path Width="15" Height="15" Data="{StaticResource IconBolt}" Fill="{StaticResource LilacBrush}" Stretch="Uniform" Visibility="{Binding AutoVisibility}" />
                    <Ellipse Stroke="#26FFFFFF" StrokeThickness="1" />
                </Grid>
            </DataTemplate>

            <!-- Two overlapping round flags: entry node, then exit node of a multihop route. -->
            <DataTemplate x:Key="FlagPairTemplate">
                <Grid Width="56" Height="34">
                    <Grid Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Fill="{StaticResource IconWellBrush}" />
                        <Grid Width="30" Height="30">
                            <Grid.Clip>
                                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                            </Grid.Clip>
                            <svgc:SvgViewbox Width="30" Height="30" Source="{Binding EntryFlagUri}" Stretch="Uniform" />
                        </Grid>
                        <Ellipse Stroke="#26FFFFFF" StrokeThickness="1" />
                    </Grid>
                    <Grid Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Fill="{StaticResource IconWellBrush}" />
                        <Grid Width="30" Height="30">
                            <Grid.Clip>
                                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                            </Grid.Clip>
                            <svgc:SvgViewbox Width="30" Height="30" Source="{Binding ExitFlagUri}" Stretch="Uniform" />
                        </Grid>
                        <Ellipse Stroke="#26FFFFFF" StrokeThickness="1" />
                    </Grid>
                </Grid>
            </DataTemplate>

            <!-- A section title in the locations list (e.g. Multihop): no card, not selectable. -->
            <Style x:Key="ServerListItem" TargetType="ListBoxItem" BasedOn="{StaticResource ServerItem}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                        <Setter Property="Cursor" Value="Arrow" />
                        <Setter Property="Margin" Value="0,12,0,8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="SupportRowTemplate">
                <Grid Margin="2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Margin="10,1,0,0" FontSize="11.5" Foreground="{StaticResource DimBrush}" Text="{Binding TimeText}" />
                    <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Row="1" Grid.Column="1" MinWidth="20" Height="20" Margin="10,2,0,0" Padding="6,0" HorizontalAlignment="Right" Background="{StaticResource DangerBrush}" CornerRadius="10" Visibility="{Binding UnreadVisibility}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" Text="{Binding Unread}" />
                    </Border>
                    <Border Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="8,2" Background="{Binding StatusBackground}" CornerRadius="8">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusForeground}" Text="{Binding StatusText}" />
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ServerRowTemplate">
                <Grid>
                    <StackPanel Margin="4,0,0,0" Visibility="{Binding HeaderVisibility}">
                        <TextBlock Style="{StaticResource Kicker}" Text="{Binding Title}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Small}" Text="{Binding HeaderHint}" TextWrapping="Wrap" Visibility="{Binding HeaderHintVisibility}" />
                    </StackPanel>
                    <Grid Visibility="{Binding RowVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FlagTemplate}" Visibility="{Binding SingleFlagVisibility}" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FlagPairTemplate}" Visibility="{Binding PairFlagVisibility}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <!-- The node runs one of Colitu's ad-blocking DNS servers. -->
                            <Border Margin="8,1,0,0" Padding="7,1" VerticalAlignment="Center" Background="#268B78FF" CornerRadius="8" Visibility="{Binding AdBlockVisibility}">
                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource LilacBrush}" Text="{Binding AdBlockText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Ping from this PC (measured outside the tunnel) with signal bars; the load is in the tooltip. -->
                    <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" Orientation="Horizontal" ToolTip="{Binding PingToolTip}" Visibility="{Binding PingVisibility}">
                        <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock MinWidth="52" FontSize="13" FontWeight="SemiBold" Foreground="{Binding PingTextBrush}" Text="{Binding PingText}" TextAlignment="Right" />
                            <!-- A route's ping is measured to its entry node only. -->
                            <TextBlock Margin="0,1,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Text="{Binding PingNote}" TextAlignment="Right" Visibility="{Binding PingNoteVisibility}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Width="4" Height="8" Margin="0,0,3,0" VerticalAlignment="Bottom" Background="{Binding PingBar1}" CornerRadius="2" />
                            <Border Width="4" Height="12" Margin="0,0,3,0" VerticalAlignment="Bottom" Background="{Binding PingBar2}" CornerRadius="2" />
                            <Border Width="4" Height="16" VerticalAlignment="Bottom" Background="{Binding PingBar3}" CornerRadius="2" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="3" MinWidth="92" Style="{StaticResource Badge}" Visibility="{Binding StateVisibility}" Background="{Binding StateBackground}">
                        <TextBlock HorizontalAlignment="Center" Foreground="{Binding StateForeground}" Style="{StaticResource BadgeText}" Text="{Binding StateText}" />
                    </Border>
                    </Grid>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource WindowEdgeBrush}" BorderThickness="1" CornerRadius="18">
    <Grid x:Name="Root" ClipToBounds="True">
        <!-- ── Backdrop (ColituBackdrop on the phones): near-black, a soft lavender
             glow behind the top and a hex dot grid fading out downwards. -->
        <Grid IsHitTestVisible="False">
            <Rectangle Fill="{StaticResource TopGlowBrush}" />
            <Rectangle Fill="{StaticResource HexDotsBrush}" OpacityMask="{StaticResource HexDotsFade}" />
        </Grid>

        <tb:TaskbarIcon x:Name="TrayIcon" IconSource="/Resources/colitu-tray.ico" ToolTipText="Colitu VPN" Visibility="Visible">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="TrayOpen_Click" FontWeight="SemiBold" Header="{s:T tray.open}" />
                    <MenuItem x:Name="TrayConnectItem" Click="TrayConnect_Click" Header="{s:T tray.connect}" />
                    <Separator />
                    <MenuItem Click="TrayExit_Click" Header="{s:T tray.exit}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- ── Loading (session restore) ─────────────────────────────────────── -->
        <Grid x:Name="LoadingView">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Width="86" Height="72" Source="/Resources/mark.png" Stretch="Uniform" />
                <Path Height="22" Margin="0,26,0,0" HorizontalAlignment="Center" Data="{StaticResource ColituWordmarkGeometry}" Fill="White" Stretch="Uniform" />
                <Ellipse Margin="0,34,0,0" Style="{StaticResource Spinner}" />
                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" Style="{StaticResource Small}" Text="{s:T loading.session}" />
            </StackPanel>
        </Grid>

        <!-- ── Sign in / sign up ─────────────────────────────────────────────── -->
        <Grid x:Name="AuthView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Margin="14,14,0,14" Padding="0" ClipToBounds="True" CornerRadius="28" Style="{StaticResource Panel}">
                <Grid>
                    <StackPanel Margin="36,32" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
                        <Image Height="26" Source="/Resources/mark.png" />
                        <Viewbox Height="14" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Grid>
                                <Path Data="{StaticResource ColituWordmarkGeometry}" Fill="White" />
                                <Path Data="{StaticResource ColituVpnGeometry}" Fill="{StaticResource AccentBrush}" />
                            </Grid>
                        </Viewbox>
                    </StackPanel>
                    <!-- Turning globe of dots, the hero of the phone sign-in. -->
                    <local:ColituParticles Width="330" Height="330" Margin="0,0,0,150" HorizontalAlignment="Center" VerticalAlignment="Center" Energy="0.5" Mode="Sphere" Color="#9F8CFF" Color2="#C4B5FD" />
                    <StackPanel Margin="36,0,36,40" VerticalAlignment="Bottom">
                        <Border HorizontalAlignment="Left" Padding="14,6" Background="#149F8CFF" BorderBrush="#669F8CFF" BorderThickness="1" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}">
                            <TextBlock FontWeight="Bold" Foreground="{StaticResource LilacBrush}" Style="{StaticResource Kicker}" Text="{s:T auth.kicker}" />
                        </Border>
                        <TextBlock Margin="0,18,0,0" MaxWidth="440" HorizontalAlignment="Left" Style="{StaticResource Display}" Text="{s:T auth.heroTitle}" />
                        <TextBlock Margin="0,12,0,0" MaxWidth="420" HorizontalAlignment="Left" FontSize="15" Style="{StaticResource Muted}" Text="{s:T auth.heroSub}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Border x:Name="AuthLanguageHost" Margin="0,16,120,0" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3" Style="{StaticResource SegmentHost}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel x:Name="AuthLanguageList" Orientation="Horizontal" />
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AuthCard" Width="420" Margin="0,70,0,30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="AuthTitle" HorizontalAlignment="Center" Style="{StaticResource H1}" TextAlignment="Center" />
                        <TextBlock x:Name="AuthSubtitle" Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource Muted}" TextAlignment="Center" />

                        <!-- The form sits in a glass card, like the phone sign-in. -->
                        <Border Margin="0,24,0,0" Padding="24,22,24,20" Style="{StaticResource Panel}">
                            <StackPanel>
                                <Border Style="{StaticResource SegmentHost}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="AuthLoginTab" Checked="AuthTab_Checked" Content="{s:T auth.login}" GroupName="AuthTab" IsChecked="True" Style="{StaticResource SegmentOption}" />
                                        <RadioButton x:Name="AuthRegisterTab" Checked="AuthTab_Checked" Content="{s:T auth.register}" GroupName="AuthTab" Style="{StaticResource SegmentOption}" />
                                    </UniformGrid>
                                </Border>

                                <TextBlock Margin="2,22,0,8" Style="{StaticResource FieldLabel}" Text="{s:T auth.email}" />
                                <TextBox x:Name="EmailBox" MaxLength="254" KeyDown="AuthField_KeyDown" Style="{StaticResource Field}" Tag="{s:T auth.emailHint}" />

                                <TextBlock Margin="2,16,0,8" Style="{StaticResource FieldLabel}" Text="{s:T auth.password}" />
                                <Grid>
                                    <PasswordBox x:Name="PasswordBox" MaxLength="256" KeyDown="AuthField_KeyDown" Style="{StaticResource PasswordField}" />
                                    <TextBox x:Name="PasswordPlainBox" MaxLength="256" KeyDown="AuthField_KeyDown" Padding="16,0,48,0" Style="{StaticResource Field}" Visibility="Collapsed" />
                                    <Button x:Name="ShowPasswordButton" Margin="0,0,8,0" HorizontalAlignment="Right" Click="ShowPassword_Click" Style="{StaticResource IconButton}" ToolTip="{s:T auth.show}">
                                        <Path Data="{StaticResource IconEye}" Style="{StaticResource Stroke}" />
                                    </Button>
                                </Grid>

                                <StackPanel x:Name="RegisterFields" Visibility="Collapsed">
                                    <TextBlock Margin="2,16,0,8" Style="{StaticResource FieldLabel}" Text="{s:T auth.passwordRepeat}" />
                                    <PasswordBox x:Name="PasswordRepeatBox" MaxLength="256" KeyDown="AuthField_KeyDown" Style="{StaticResource PasswordField}" />
                                    <CheckBox x:Name="TermsCheck" Margin="2,18,0,0" Style="{StaticResource FieldCheck}">
                                        <TextBlock TextWrapping="Wrap">
                                            <Hyperlink Click="TermsLink_Click" Foreground="{StaticResource LilacBrush}" TextDecorations="{x:Null}"><Run Text="{s:T auth.terms}" /></Hyperlink>
                                        </TextBlock>
                                    </CheckBox>
                                </StackPanel>

                                <Border x:Name="AuthErrorBox" Margin="0,18,0,0" Padding="14,10" Background="#1AFF6B7A" BorderBrush="#59FF6B7A" BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
                                    <TextBlock x:Name="AuthErrorText" FontSize="13" Foreground="#FFA3AE" TextWrapping="Wrap" />
                                </Border>

                                <Button x:Name="AuthSubmitButton" Height="52" Margin="0,22,0,0" HorizontalAlignment="Stretch" Click="AuthSubmit_Click" Style="{StaticResource PrimaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="AuthSpinner" Margin="0,0,10,0" Stroke="{StaticResource OnAccentBrush}" Style="{StaticResource Spinner}" Visibility="Collapsed" />
                                        <TextBlock x:Name="AuthSubmitText" FontSize="15.5" />
                                    </StackPanel>
                                </Button>

                                <Grid Margin="0,16,0,0">
                                    <Button x:Name="ForgotButton" HorizontalAlignment="Left" Click="Forgot_Click" Content="{s:T auth.forgot}" Style="{StaticResource LinkButton}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Path Width="13" Height="13" Margin="0,0,6,0" Data="{StaticResource IconLock}" Stretch="Uniform" Stroke="{StaticResource DimBrush}" StrokeThickness="1.6" />
                                        <TextBlock MaxWidth="220" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{s:T auth.remember}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ── Password reset ──────────────────────────────────────────────── -->
        <Grid x:Name="ResetView" Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Border Width="468" Margin="0,36" Padding="38,36" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Panel}">
                    <StackPanel x:Name="ResetCard">
                        <Grid Width="64" Height="64" HorizontalAlignment="Left">
                            <Ellipse Fill="{StaticResource IconWellBrush}" Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1" />
                            <Path Width="26" Height="26" Data="{StaticResource IconLock}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                        </Grid>
                        <TextBlock Margin="0,24,0,0" Style="{StaticResource H1}" Text="{s:T reset.title}" />
                        <TextBlock x:Name="ResetSubtitle" Margin="0,10,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        <TextBlock Margin="2,24,0,8" Style="{StaticResource FieldLabel}" Text="{s:T auth.email}" />
                        <TextBox x:Name="ResetEmailBox" MaxLength="254" KeyDown="ResetField_KeyDown" Style="{StaticResource Field}" Tag="{s:T auth.emailHint}" />
                        <StackPanel x:Name="ResetCodeFields" Visibility="Collapsed">
                            <TextBlock Margin="2,16,0,8" Style="{StaticResource FieldLabel}" Text="{s:T verify.code}" />
                            <TextBox x:Name="ResetCodeBox" Height="58" Padding="16,0" FontSize="24" FontWeight="SemiBold" InputMethod.IsInputMethodEnabled="False" DataObject.Pasting="VerifyCode_Pasting" KeyDown="ResetField_KeyDown" MaxLength="6" PreviewTextInput="VerifyCode_PreviewTextInput" Style="{StaticResource Field}" TextAlignment="Center" />
                            <TextBlock Margin="2,16,0,8" Style="{StaticResource FieldLabel}" Text="{s:T reset.newPassword}" />
                            <PasswordBox x:Name="ResetPasswordBox" MaxLength="256" KeyDown="ResetField_KeyDown" Style="{StaticResource PasswordField}" />
                            <TextBlock Margin="2,6,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{s:T auth.passwordHint}" />
                            <TextBlock Margin="2,14,0,8" Style="{StaticResource FieldLabel}" Text="{s:T auth.passwordRepeat}" />
                            <PasswordBox x:Name="ResetRepeatBox" MaxLength="256" KeyDown="ResetField_KeyDown" Style="{StaticResource PasswordField}" />
                        </StackPanel>
                        <Border x:Name="ResetInfoBox" Margin="0,16,0,0" Padding="14,10" Background="#149F8CFF" BorderBrush="#599F8CFF" BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
                            <TextBlock x:Name="ResetInfoText" FontSize="13" Foreground="{StaticResource LilacBrush}" TextWrapping="Wrap" />
                        </Border>
                        <Border x:Name="ResetErrorBox" Margin="0,16,0,0" Padding="14,10" Background="#1AFF6B7A" BorderBrush="#59FF6B7A" BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
                            <TextBlock x:Name="ResetErrorText" FontSize="13" Foreground="#FFA3AE" TextWrapping="Wrap" />
                        </Border>
                        <Button x:Name="ResetSubmitButton" Height="52" Margin="0,20,0,0" HorizontalAlignment="Stretch" Click="ResetSubmit_Click" Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ResetSpinner" Margin="0,0,10,0" Stroke="{StaticResource OnAccentBrush}" Style="{StaticResource Spinner}" Visibility="Collapsed" />
                                <TextBlock x:Name="ResetSubmitText" FontSize="15.5" />
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,18,0,0">
                            <Button x:Name="ResetResendButton" HorizontalAlignment="Left" Click="ResetResend_Click" Style="{StaticResource LinkButton}" Visibility="Collapsed">
                                <TextBlock x:Name="ResetResendText" />
                            </Button>
                            <Button HorizontalAlignment="Right" Click="ResetBack_Click" Content="{s:T reset.back}" Style="{StaticResource LinkButton}" />
                        </Grid>
                        <Button x:Name="ResetChangeEmailButton" Margin="0,8,0,0" HorizontalAlignment="Left" Click="ResetChangeEmail_Click" Content="{s:T reset.changeEmail}" Style="{StaticResource LinkButton}" Visibility="Collapsed" />
                        <TextBlock x:Name="ResetNote" Margin="0,16,0,0" Style="{StaticResource Small}" Text="{s:T reset.note}" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- ── E-mail verification ───────────────────────────────────────────── -->
        <Grid x:Name="VerifyView" Visibility="Collapsed">
            <Border Width="468" Padding="38,36" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Panel}">
                <StackPanel x:Name="VerifyCard">
                    <Grid Width="64" Height="64" HorizontalAlignment="Left">
                        <Ellipse Fill="{StaticResource IconWellBrush}" Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1" />
                        <Path Width="26" Height="26" Data="{StaticResource IconMail}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                    </Grid>
                    <TextBlock Margin="0,24,0,0" Style="{StaticResource Kicker}" Text="{s:T verify.kicker}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource H1}" Text="{s:T verify.title}" />
                    <TextBlock x:Name="VerifySubtitle" Margin="0,10,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    <TextBlock Margin="2,26,0,8" Style="{StaticResource FieldLabel}" Text="{s:T verify.code}" />
                    <TextBox x:Name="VerifyCodeBox" Height="66" Padding="16,0" FontSize="30" FontWeight="SemiBold" InputMethod.IsInputMethodEnabled="False" DataObject.Pasting="VerifyCode_Pasting" KeyDown="VerifyCode_KeyDown" MaxLength="6" PreviewTextInput="VerifyCode_PreviewTextInput" TextChanged="VerifyCode_TextChanged" Style="{StaticResource Field}" TextAlignment="Center" />
                    <Border x:Name="VerifyErrorBox" Margin="0,16,0,0" Padding="14,10" Background="#1AFF6B7A" BorderBrush="#59FF6B7A" BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
                        <TextBlock x:Name="VerifyErrorText" FontSize="13" Foreground="#FFA3AE" TextWrapping="Wrap" />
                    </Border>
                    <Button x:Name="VerifySubmitButton" Height="52" Margin="0,20,0,0" HorizontalAlignment="Stretch" Click="VerifySubmit_Click" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="VerifySpinner" Margin="0,0,10,0" Stroke="{StaticResource OnAccentBrush}" Style="{StaticResource Spinner}" Visibility="Collapsed" />
                            <TextBlock FontSize="15.5" Text="{s:T verify.submit}" />
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,18,0,0">
                        <Button x:Name="VerifyResendButton" HorizontalAlignment="Left" Click="VerifyResend_Click" Style="{StaticResource LinkButton}">
                            <TextBlock x:Name="VerifyResendText" />
                        </Button>
                        <Button HorizontalAlignment="Right" Click="VerifyOtherAccount_Click" Content="{s:T verify.other}" Style="{StaticResource LinkButton}" />
                    </Grid>
                    <TextBlock Margin="0,20,0,0" Style="{StaticResource Small}" Text="{s:T verify.hint}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Small}" Text="{s:T verify.web}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Two-factor code (2FA is set up on colitu.com only) ─────────────── -->
        <Grid x:Name="MfaView" Visibility="Collapsed">
            <Border Width="468" Padding="38,36" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Panel}">
                <StackPanel x:Name="MfaCard">
                    <Grid Width="64" Height="64" HorizontalAlignment="Left">
                        <Ellipse Fill="{StaticResource IconWellBrush}" Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1" />
                        <Path Width="26" Height="26" Data="{StaticResource IconShield}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                    </Grid>
                    <TextBlock Margin="0,24,0,0" Style="{StaticResource Kicker}" Text="{s:T mfa.kicker}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource H1}" Text="{s:T mfa.title}" />
                    <TextBlock x:Name="MfaSubtitle" Margin="0,10,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MfaCodeLabel" Margin="2,26,0,8" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="MfaCodeBox" Height="66" Padding="16,0" FontSize="30" FontWeight="SemiBold" InputMethod.IsInputMethodEnabled="False" DataObject.Pasting="MfaCode_Pasting" KeyDown="MfaCode_KeyDown" MaxLength="6" PreviewTextInput="MfaCode_PreviewTextInput" TextChanged="MfaCode_TextChanged" Style="{StaticResource Field}" TextAlignment="Center" />
                    <Border x:Name="MfaErrorBox" Margin="0,16,0,0" Padding="14,10" Background="#1AFF6B7A" BorderBrush="#59FF6B7A" BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
                        <TextBlock x:Name="MfaErrorText" FontSize="13" Foreground="#FFA3AE" TextWrapping="Wrap" />
                    </Border>
                    <Button x:Name="MfaSubmitButton" Height="52" Margin="0,20,0,0" HorizontalAlignment="Stretch" Click="MfaSubmit_Click" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MfaSpinner" Margin="0,0,10,0" Stroke="{StaticResource OnAccentBrush}" Style="{StaticResource Spinner}" Visibility="Collapsed" />
                            <TextBlock FontSize="15.5" Text="{s:T mfa.submit}" />
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,18,0,0">
                        <Button x:Name="MfaModeButton" HorizontalAlignment="Left" Click="MfaMode_Click" Style="{StaticResource LinkButton}">
                            <TextBlock x:Name="MfaModeText" />
                        </Button>
                        <Button HorizontalAlignment="Right" Click="MfaBack_Click" Content="{s:T mfa.back}" Style="{StaticResource LinkButton}" />
                    </Grid>
                    <TextBlock Margin="0,20,0,0" Style="{StaticResource Small}" Text="{s:T mfa.hint}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Signed-in app ─────────────────────────────────────────────────── -->
        <Grid x:Name="AppView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="24,0,160,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Image Height="28" Source="/Resources/mark.png" />
                    <Path Height="14" Margin="14,0,0,0" VerticalAlignment="Center" Data="{StaticResource ColituWordmarkGeometry}" Fill="White" Stretch="Uniform" />
                </StackPanel>

                <!-- Floating pill with the tabs; the active one is lavender (ColituNavBar). -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F2141419" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Padding="4">
                    <Grid>
                        <Border x:Name="NavThumb" HorizontalAlignment="Left" Background="{StaticResource ActionBrush}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Effect="{StaticResource ButtonGlow}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavThumbShift" />
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel x:Name="NavList" Orientation="Horizontal">
                            <RadioButton x:Name="NavHome" Checked="Nav_Checked" Content="{s:T nav.home}" GroupName="Nav" IsChecked="True" Style="{StaticResource NavTab}" Tag="home" />
                            <RadioButton x:Name="NavLocations" Checked="Nav_Checked" Content="{s:T nav.locations}" GroupName="Nav" Style="{StaticResource NavTab}" Tag="locations" />
                            <RadioButton x:Name="NavPlan" Checked="Nav_Checked" Content="{s:T nav.plan}" GroupName="Nav" Style="{StaticResource NavTab}" Tag="plan" />
                            <RadioButton x:Name="NavAccount" Checked="Nav_Checked" Content="{s:T nav.account}" GroupName="Nav" Style="{StaticResource NavTab}" Tag="account" />
                            <RadioButton x:Name="NavSettings" Checked="Nav_Checked" Content="{s:T nav.settings}" GroupName="Nav" Style="{StaticResource NavTab}" Tag="settings" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="UpdateButton" Height="32" Margin="0,0,10,0" Padding="12,0" Click="UpdateButton_Click" Style="{StaticResource SecondaryButton}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Margin="0,0,7,0" Data="{StaticResource IconDownload}" Style="{StaticResource Stroke}" />
                            <TextBlock x:Name="UpdateButtonText" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="StatusChip" Height="38" Padding="12,0,16,0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Grid Width="12" Height="12" Margin="0,0,10,0">
                                <Ellipse x:Name="StatusDotHalo" Fill="#5EE0A0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="StatusDotHaloScale" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#FF6B7A" />
                            </Grid>
                            <TextBlock x:Name="StatusChipText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="Pages" Grid.Row="1">
                <!-- Home -->
                <Grid x:Name="HomePage" Margin="44,4,40,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="372" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,28,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Connect button with the particle ring behind it (ColituPowerButton on the phones). -->
                        <Grid x:Name="Orb" Width="440" Height="440" Margin="0,-40,0,-50" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <local:ColituParticles x:Name="OrbParticles" Energy="0.22" Mode="Ring" Color="#9483FF" Color2="#C4B5FD" />
                            <Button x:Name="ConnectButton" Width="204" Height="204" Click="ConnectButton_Click" Cursor="Hand" FocusVisualStyle="{x:Null}" RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <ScaleTransform x:Name="ConnectScale" />
                                </Button.RenderTransform>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse x:Name="Glow" Margin="-4" Fill="#9F8CFF" IsHitTestVisible="False" Opacity="0.28">
                                                <Ellipse.Effect>
                                                    <BlurEffect Radius="42" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <Ellipse Margin="14,34,14,-12" Fill="#80000000" IsHitTestVisible="False">
                                                <Ellipse.Effect>
                                                    <BlurEffect Radius="30" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Offset="0" Color="#D0C4FF" />
                                                        <GradientStop Offset="0.5" Color="#9F8CFF" />
                                                        <GradientStop Offset="1" Color="#7A69EE" />
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <!-- Glass rim and gloss. -->
                                            <Ellipse Margin="3" IsHitTestVisible="False" Stroke="#59FFFFFF" StrokeThickness="1.2">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush Center="0.35,0.3" GradientOrigin="0.35,0.3" RadiusX="0.5" RadiusY="0.5">
                                                        <GradientStop Offset="0" Color="#38FFFFFF" />
                                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse x:Name="Hover" Fill="#1FFFFFFF" Opacity="0" />
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Hover" Property="Fill" Value="#33FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Path x:Name="PowerIcon" Width="58" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconPower}" Stretch="Uniform" Stroke="White" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="3.4" />
                                    <TextBlock x:Name="SessionTimer" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="34" FontWeight="Bold" Foreground="White" Text="00:00:00" Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                            <TextBlock x:Name="ConnectLabel" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="HomeTitle" Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="22" Style="{StaticResource H2}" TextAlignment="Center" />
                            <TextBlock x:Name="HomeSubtitle" Margin="0,6,0,0" MaxWidth="500" HorizontalAlignment="Center" Style="{StaticResource Small}" FontSize="13.5" TextAlignment="Center" />
                            <Border x:Name="ProtocolChip" Margin="0,14,0,0" HorizontalAlignment="Center" Style="{StaticResource Chip}" Visibility="Collapsed">
                                <TextBlock x:Name="ProtocolChipText" Style="{StaticResource ChipText}" />
                            </Border>
                            <!-- Multihop: "Entry FI to Exit DE"; rotating IP: current exit and the countdown to the next change. -->
                            <Border x:Name="RouteChip" Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Chip}" Visibility="Collapsed">
                                <TextBlock x:Name="RouteChipText" Style="{StaticResource ChipText}" />
                            </Border>
                            <!-- Russian sites leave outside the tunnel (privacy mode off, server outside Russia); opens the setting. -->
                            <Border x:Name="RuDirectChip" Margin="0,8,0,0" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="RuDirectChip_Click" Style="{StaticResource Chip}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="11" Height="12" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource IconShield}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeLineJoin="Round" StrokeThickness="1.6" />
                                    <TextBlock x:Name="RuDirectChipText" Style="{StaticResource ChipText}" />
                                </StackPanel>
                            </Border>
                            <!-- Split tunnelling active; opens the setting. -->
                            <Border x:Name="SplitChip" Margin="0,8,0,0" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="SplitChip_Click" Style="{StaticResource Chip}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource IconChevron}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeLineJoin="Round" StrokeThickness="1.6" />
                                    <TextBlock x:Name="SplitChipText" Style="{StaticResource ChipText}" />
                                </StackPanel>
                            </Border>
                            <!-- Proxy mode in effect: not everything is protected; opens the mode setting. -->
                            <Border x:Name="ProxyCoverageChip" Margin="0,8,0,0" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="ProxyCoverageChip_Click" Style="{StaticResource Chip}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="11" Height="12" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource IconShield}" Stretch="Uniform" Stroke="#F5C36B" StrokeLineJoin="Round" StrokeThickness="1.6" />
                                    <TextBlock x:Name="ProxyCoverageChipText" Style="{StaticResource ChipText}" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="UnblockButton" Margin="0,12,0,0" HorizontalAlignment="Center" Click="Unblock_Click" Content="{s:T home.unblock}" Style="{StaticResource LinkButton}" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HomeCards">
                            <!-- Trial ends within 3 days (dismissible per day). -->
                            <Border x:Name="TrialBanner" Margin="0,0,0,16" Padding="18,16" Background="#149F8CFF" BorderBrush="#599F8CFF" BorderThickness="1" CornerRadius="20" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="TrialBannerText" FontSize="13.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Margin="0,0,18,0" Click="TrialKeep_Click" Content="{s:T trial.keep}" Style="{StaticResource LinkButton}" />
                                        <Button Click="TrialDismiss_Click" Content="{s:T trial.dismiss}" Style="{StaticResource LinkButton}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Location -->
                            <Border Cursor="Hand" MouseLeftButtonUp="LocationCard_Click" Style="{StaticResource Panel}" Padding="20">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="52" Height="52">
                                            <ContentPresenter x:Name="HomeFlag" ContentTemplate="{StaticResource FlagTemplate}" />
                                        </Viewbox>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="HomeServerTitle" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="HomeServerSubtitle" Margin="0,3,0,0" FontSize="13.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border x:Name="HomeServerCheck" Grid.Column="2" Width="22" Height="22" Margin="10,0,2,0" BorderBrush="{StaticResource DimBrush}" BorderThickness="1.6" CornerRadius="11">
                                            <Path x:Name="HomeServerCheckMark" Width="10" Height="8" Data="{StaticResource IconCheck}" Stretch="Fill" Stroke="{StaticResource OnAccentBrush}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="2" Visibility="Collapsed" />
                                        </Border>
                                    </Grid>
                                    <Button Height="48" Margin="0,18,0,0" HorizontalAlignment="Stretch" Click="ChangeServer_Click" Style="{StaticResource PrimaryButton}">
                                        <TextBlock FontSize="15" Text="{s:T home.changeServer}" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Plan -->
                            <Border Margin="0,16,0,0" Style="{StaticResource Panel}" Padding="20,18,20,18">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Kicker}" Text="{s:T home.plan}" />
                                        <Border x:Name="PlanBadge" HorizontalAlignment="Right" Padding="14,6" Style="{StaticResource Badge}">
                                            <TextBlock x:Name="PlanBadgeText" FontSize="12" Style="{StaticResource BadgeText}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="PlanName" Margin="0,10,0,0" FontSize="22" Style="{StaticResource H2}" />
                                    <TextBlock x:Name="PlanDetail" Margin="0,6,0,0" FontSize="13.5" Foreground="{StaticResource MutedBrush}" Style="{StaticResource Body}" />
                                    <Border Margin="0,16,0,0" Style="{StaticResource Divider}" />
                                    <StackPanel x:Name="TrafficBlock" Margin="0,14,0,0">
                                        <Grid>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{s:T home.traffic}" />
                                            <TextBlock x:Name="TrafficText" Style="{StaticResource RowValue}" />
                                        </Grid>
                                        <Grid x:Name="TrafficTrack" Height="6" Margin="0,10,0,0">
                                            <Border Background="{StaticResource Glass10Brush}" CornerRadius="3" />
                                            <Border x:Name="TrafficFill" Width="0" HorizontalAlignment="Left" Background="{StaticResource ActionBrush}" CornerRadius="3" />
                                        </Grid>
                                        <Border Margin="0,14,0,0" Style="{StaticResource Divider}" />
                                    </StackPanel>
                                    <Grid Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{s:T home.devices}" />
                                        <TextBlock x:Name="DevicesText" Style="{StaticResource RowValue}" />
                                    </Grid>
                                    <Button x:Name="PlanCtaButton" Height="44" Margin="0,18,0,0" HorizontalAlignment="Stretch" Click="PlanCta_Click" Style="{StaticResource PrimaryButton}" Visibility="Collapsed">
                                        <TextBlock x:Name="PlanCtaText" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Quick settings -->
                            <Border Margin="0,16,0,0" Style="{StaticResource Panel}" Padding="20,18,20,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Kicker}" Text="{s:T home.quick}" />
                                    <Border Margin="0,16,0,0" Style="{StaticResource SegmentHost}">
                                        <UniformGrid Rows="1">
                                            <RadioButton x:Name="HomeModeProxy" Checked="Mode_Checked" Content="{s:T settings.mode.proxy}" GroupName="HomeMode" MinHeight="44" FontSize="14.5" Style="{StaticResource SegmentOption}" Tag="proxy" />
                                            <RadioButton x:Name="HomeModeTun" Checked="Mode_Checked" Content="{s:T settings.mode.tun}" GroupName="HomeMode" MinHeight="44" FontSize="14.5" Style="{StaticResource SegmentOption}" Tag="tun" />
                                        </UniformGrid>
                                    </Border>
                                    <Grid Margin="0,14,0,0" MinHeight="44">
                                        <TextBlock FontSize="15" Style="{StaticResource RowLabel}" Foreground="{StaticResource TextBrush}" Text="{s:T settings.killSwitch}" />
                                        <CheckBox x:Name="HomeKillSwitch" HorizontalAlignment="Right" Checked="Preference_Click" Style="{StaticResource Switch}" Unchecked="Preference_Click" />
                                    </Grid>
                                    <Border Style="{StaticResource Divider}" />
                                    <Grid MinHeight="52">
                                        <TextBlock FontSize="15" Style="{StaticResource RowLabel}" Foreground="{StaticResource TextBrush}" Text="{s:T settings.autoConnect}" />
                                        <CheckBox x:Name="HomeAutoConnect" HorizontalAlignment="Right" Checked="Preference_Click" Style="{StaticResource Switch}" Unchecked="Preference_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Locations -->
                <Grid x:Name="LocationsPage" Margin="44,4,40,26" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Kicker}" Text="{s:T locations.kicker}" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource H1}" Text="{s:T locations.title}" />
                            <TextBlock x:Name="LocationsSubtitle" Margin="0,8,0,0" Style="{StaticResource Muted}" />
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Bottom">
                            <TextBox x:Name="ServerSearchBox" Padding="42,0,16,0" Style="{StaticResource Field}" Tag="{s:T locations.search}" TextChanged="ServerSearch_TextChanged" />
                            <Path Width="16" Height="16" Margin="16,0,0,0" HorizontalAlignment="Left" Data="{StaticResource IconSearch}" IsHitTestVisible="False" Stretch="Uniform" Stroke="{StaticResource DimBrush}" StrokeThickness="1.8" />
                        </Grid>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,0,0,16" HorizontalAlignment="Left" Style="{StaticResource SegmentHost}">
                        <StackPanel x:Name="CategoryList" Orientation="Horizontal" />
                    </Border>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="ServerList" ItemContainerStyle="{StaticResource ServerListItem}" ItemTemplate="{StaticResource ServerRowTemplate}" SelectionChanged="ServerList_SelectionChanged" Style="{StaticResource PlainList}" />
                        <TextBlock x:Name="ServerListEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}" Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- Plan -->
                <ScrollViewer x:Name="PlanPage" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="44,4,40,30">
                        <TextBlock Style="{StaticResource Kicker}" Text="{s:T pricing.kicker}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource H1}" Text="{s:T pricing.title}" />
                        <TextBlock Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left" Style="{StaticResource Muted}" Text="{s:T pricing.sub}" />

                        <Border x:Name="CurrentPlanStrip" Margin="0,20,0,0" Style="{StaticResource Tile}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Width="18" Height="18" Data="{StaticResource IconShield}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeThickness="1.8" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Small}" Text="{s:T pricing.current}" />
                                    <TextBlock Margin="8,0,0,0" FontSize="12.5" Text="·" Foreground="{StaticResource DimBrush}" />
                                    <TextBlock x:Name="CurrentPlanText" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border x:Name="CurrentPlanBadge" Grid.Column="2" Style="{StaticResource Badge}">
                                    <TextBlock x:Name="CurrentPlanBadgeText" Style="{StaticResource BadgeText}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Nothing is bought in the app, as on iOS and Android: the subscription
                             is managed in the customer account on app.colitu.com. -->
                        <Border Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left" Padding="28" Style="{StaticResource Panel}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="48" Height="48" VerticalAlignment="Top">
                                        <Ellipse Fill="{StaticResource IconWellBrush}" Stroke="{StaticResource LineStrongBrush}" />
                                        <Path Width="22" Height="22" Data="{StaticResource IconShield}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeThickness="1.8" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="16,2,0,0">
                                        <TextBlock Style="{StaticResource H2}" Text="{s:T plan.manageTitle}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}" Text="{s:T plan.manageBody}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                                    <Button MinWidth="240" Height="50" Padding="22,0" Click="ManagePlan_Click" Style="{StaticResource PrimaryButton}">
                                        <TextBlock FontSize="14.5" Text="{s:T plan.manageButton}" />
                                    </Button>
                                    <Button x:Name="PlanRefreshButton" MinWidth="180" Height="50" Margin="12,0,0,0" Padding="22,0" Click="PlanRefresh_Click" Style="{StaticResource SecondaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="PlanRefreshSpinner" Margin="0,0,10,0" Style="{StaticResource Spinner}" Visibility="Collapsed" />
                                            <TextBlock FontSize="14" Text="{s:T plan.refresh}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                    <Path Width="13" Height="13" Margin="0,2,8,0" VerticalAlignment="Top" Data="{StaticResource IconLock}" Stretch="Uniform" Stroke="{StaticResource DimBrush}" StrokeThickness="1.6" />
                                    <TextBlock MaxWidth="600" FontSize="12" Foreground="{StaticResource DimBrush}" Text="{s:T plan.refreshHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Account -->
                <ScrollViewer x:Name="AccountPage" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="44,4,40,30">
                        <TextBlock Style="{StaticResource Kicker}" Text="{s:T account.kicker}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource H1}" Text="{s:T account.title}" />
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border Padding="26" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="60" Height="60">
                                                <Ellipse Fill="{StaticResource AccentBrush}" />
                                                <TextBlock x:Name="AvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="AccountEmail" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="AccountId" Margin="0,3,0,0" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Margin="0,22,0,0" Background="{StaticResource LineBrush}" />
                                        <Grid Margin="0,16,0,0">
                                            <TextBlock Style="{StaticResource Small}" Text="{s:T account.plan}" />
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <TextBlock x:Name="AccountPlan" VerticalAlignment="Center" FontSize="13.5" FontWeight="Medium" />
                                                <Border x:Name="AccountPlanBadge" Margin="10,0,0,0" Style="{StaticResource Badge}">
                                                    <TextBlock x:Name="AccountPlanBadgeText" Style="{StaticResource BadgeText}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,14,0,0">
                                            <TextBlock Style="{StaticResource Small}" Text="{s:T account.validUntil}" />
                                            <TextBlock x:Name="AccountUntil" HorizontalAlignment="Right" FontSize="13.5" FontWeight="Medium" />
                                        </Grid>
                                        <WrapPanel Margin="0,24,0,0">
                                            <Button Height="42" Margin="0,0,10,10" Padding="18,0" Click="ManageAccount_Click" Style="{StaticResource SecondaryButton}">
                                                <TextBlock FontSize="13.5" Text="{s:T account.manage}" />
                                            </Button>
                                            <Button Height="42" Margin="0,0,10,10" Padding="18,0" Click="Security_Click" Style="{StaticResource SecondaryButton}">
                                                <TextBlock FontSize="13.5" Text="{s:T account.security}" />
                                            </Button>
                                            <Button Height="42" Margin="0,0,10,10" Padding="18,0" Click="ManualConfig_Click" Style="{StaticResource SecondaryButton}">
                                                <TextBlock FontSize="13.5" Text="{s:T account.manualConfig}" />
                                            </Button>
                                            <Button Height="42" Margin="0,0,10,10" Padding="18,0" Click="SignOut_Click" Style="{StaticResource DangerButton}">
                                                <TextBlock FontSize="13.5" Text="{s:T account.signOut}" />
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,16,0,0" Padding="26" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="{s:T account.help}" />
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Muted}" Text="{s:T account.helpHint}" />
                                        <WrapPanel Margin="0,18,0,0">
                                            <Button Height="40" Margin="0,0,10,0" Padding="16,0" Click="Support_Click" Style="{StaticResource SecondaryButton}">
                                                <TextBlock FontSize="13.5" Text="{s:T account.support}" />
                                            </Button>
                                            <Button Height="40" Padding="16,0" Click="MailSupport_Click" Style="{StaticResource SecondaryButton}">
                                                <TextBlock FontSize="13.5" Text="{s:T account.mail}" />
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="2" VerticalAlignment="Top" Padding="26" Style="{StaticResource Panel}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Kicker}" Text="{s:T account.devices}" />
                                    <TextBlock x:Name="DevicesTitle" Margin="0,10,0,0" Style="{StaticResource H2}" />
                                    <ItemsControl x:Name="DeviceList" Margin="0,16,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="14,12" Style="{StaticResource Tile}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="36" Height="36">
                                                            <Ellipse Fill="{StaticResource IconWellBrush}" Stroke="{StaticResource LineBrush}" />
                                                            <Path Width="17" Height="17" Data="{StaticResource IconDevice}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeLineJoin="Round" StrokeThickness="1.7" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                                                                <Border Margin="8,0,0,0" Style="{StaticResource Badge}" Padding="7,2" Visibility="{Binding CurrentVisibility}">
                                                                    <TextBlock FontSize="9.5" Style="{StaticResource BadgeText}" Text="{s:T account.thisDevice}" />
                                                                </Border>
                                                                <!-- Paused by the plan's device limit (suspended_reason over_limit). -->
                                                                <Border Margin="8,0,0,0" Padding="7,2" Background="#26F5C36B" CornerRadius="8" Visibility="{Binding PausedVisibility}">
                                                                    <TextBlock FontSize="9.5" FontWeight="Bold" Foreground="#F5C36B" Text="{s:T account.paused}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding Detail}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <Button Margin="0,0,6,0" VerticalAlignment="Center" Click="ActivateDevice_Click" Content="{s:T account.activate}" FontSize="12.5" Style="{StaticResource LinkButton}" Tag="{Binding}" Visibility="{Binding PausedVisibility}" />
                                                            <Button Click="RemoveDevice_Click" Style="{StaticResource IconButton}" Tag="{Binding}" ToolTip="{s:T account.remove}">
                                                                <Path Width="12" Height="12" Data="{StaticResource IconX}" Style="{StaticResource Stroke}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPage" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="44,4,40,30">
                        <TextBlock Style="{StaticResource Kicker}" Text="{s:T settings.kicker}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource H1}" Text="{s:T settings.title}" />
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border Padding="24" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="{s:T settings.connection}" />
                                        <TextBlock Margin="0,18,0,10" Style="{StaticResource FieldLabel}" Text="{s:T settings.mode}" />
                                        <Border Style="{StaticResource SegmentHost}">
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="SettingsModeProxy" Checked="Mode_Checked" Content="{s:T settings.mode.proxy}" GroupName="SettingsMode" Style="{StaticResource SegmentOption}" Tag="proxy" />
                                                <RadioButton x:Name="SettingsModeTun" Checked="Mode_Checked" Content="{s:T settings.mode.tun}" GroupName="SettingsMode" Style="{StaticResource SegmentOption}" Tag="tun" />
                                            </UniformGrid>
                                        </Border>
                                        <TextBlock x:Name="ModeHint" Margin="2,10,0,0" Style="{StaticResource Small}" />

                                        <Grid Margin="0,22,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock FontSize="14.5" FontWeight="Medium" Text="{s:T settings.killSwitch}" />
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource Small}" Text="{s:T settings.killSwitchHint}" />
                                            </StackPanel>
                                            <CheckBox x:Name="SettingsKillSwitch" Grid.Column="1" Checked="Preference_Click" Style="{StaticResource Switch}" Unchecked="Preference_Click" />
                                        </Grid>
                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock FontSize="14.5" FontWeight="Medium" Text="{s:T settings.killSwitchLan}" />
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource Small}" Text="{s:T settings.killSwitchLanHint}" />
                                            </StackPanel>
                                            <CheckBox x:Name="SettingsKillSwitchLan" Grid.Column="1" Checked="Preference_Click" Style="{StaticResource Switch}" Unchecked="Preference_Click" />
                                        </Grid>
                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock FontSize="14.5" FontWeight="Medium" Text="{s:T settings.dns}" />
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource Small}" Text="{s:T settings.dnsHint}" />
                                            </StackPanel>
                                            <CheckBox x:Name="SettingsDns" Grid.Column="1" Checked="Preference_Click" Style="{StaticResource Switch}" Unchecked="Preference_Click" />
                                        </Grid>
                                        <Grid x:Name="SettingsAdBlockRow" Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock FontSize="14.5" FontWeight="Medium" Text="{s:T settings.adBlock}" />
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource Small}" Text="{s:T settings.adBlockHint}" />
                                            </StackPanel>
                                            <CheckBox x:Name="SettingsAdBlock" Grid.Column="1" Checked="Preference_Click" Style="{StaticResource Switch}" Unchecked="Preference_Click" />
                                        </Grid>
                                        <Grid x:Name="SettingsPrivacyRow" Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock FontSize="14.5" FontWeight="Medium" Text="{s:T privacy.title}" />
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource Small}" Text="{s:T privacy.hint}" />
                                                <Button Margin="0,6,0,0" HorizontalAlignment="Left" Click="PrivacyScope_Click" Content="{s:T privacy.scope}" FontSize="12.5" Style="{StaticResource LinkButton}" />
                                            </StackPanel>
                                            <CheckBox x:Name="SettingsPrivacy" Grid.Column="1" Checked="Preference_Click" Style="{StaticResource Switch}" Unchecked="Preference_Click" />
                                        </Grid>
                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock FontSize="14.5" FontWeight="Medium" Text="{s:T settings.autoConnect}" />
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource Small}" Text="{s:T settings.autoConnectHint}" />
                                            </StackPanel>
                                            <CheckBox x:Name="SettingsAutoConnect" Grid.Column="1" Checked="Preference_Click" Style="{StaticResource Switch}" Unchecked="Preference_Click" />
                                        </Grid>
                                        <TextBlock x:Name="SettingsNote" Margin="0,16,0,0" FontSize="12.5" Foreground="{StaticResource LilacBrush}" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <!-- Split tunnelling -->
                                <Border x:Name="SplitCard" Margin="0,16,0,0" Padding="24" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="{s:T split.title}" />
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Small}" Text="{s:T split.hint}" TextWrapping="Wrap" />
                                        <Border Margin="0,16,0,0" Style="{StaticResource SegmentHost}">
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="SplitModeOff" Checked="SplitMode_Checked" Content="{s:T split.mode.off}" GroupName="SplitMode" FontSize="12.5" Style="{StaticResource SegmentOption}" Tag="off" />
                                                <RadioButton x:Name="SplitModeBypass" Checked="SplitMode_Checked" Content="{s:T split.mode.bypass}" GroupName="SplitMode" FontSize="12.5" Style="{StaticResource SegmentOption}" Tag="bypass" />
                                                <RadioButton x:Name="SplitModeOnly" Checked="SplitMode_Checked" Content="{s:T split.mode.only}" GroupName="SplitMode" FontSize="12.5" Style="{StaticResource SegmentOption}" Tag="only" />
                                            </UniformGrid>
                                        </Border>
                                        <TextBlock x:Name="SplitModeHint" Margin="2,10,0,0" Style="{StaticResource Small}" TextWrapping="Wrap" />
                                        <StackPanel x:Name="SplitLists">
                                            <TextBlock Margin="2,18,0,8" Style="{StaticResource FieldLabel}" Text="{s:T split.apps}" />
                                            <TextBlock x:Name="SplitProxyNote" Margin="2,0,0,8" FontSize="12.5" Foreground="#F5C36B" Text="{s:T split.proxyNote}" TextWrapping="Wrap" Visibility="Collapsed" />
                                            <ItemsControl x:Name="SplitAppsList" />
                                            <Button Margin="0,6,0,0" HorizontalAlignment="Left" Click="SplitAddApp_Click" Content="{s:T split.addApp}" Style="{StaticResource LinkButton}" />

                                            <TextBlock Margin="2,18,0,8" Style="{StaticResource FieldLabel}" Text="{s:T split.sites}" />
                                            <ItemsControl x:Name="SplitDomainsList" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="SplitDomainBox" MaxLength="253" KeyDown="SplitDomainBox_KeyDown" Style="{StaticResource Field}" Tag="{s:T split.domainHint}" />
                                                <Button Grid.Column="1" Height="44" Margin="10,0,0,0" Padding="16,0" Click="SplitAddDomain_Click" Style="{StaticResource SecondaryButton}">
                                                    <TextBlock FontSize="13" Text="{s:T split.add}" />
                                                </Button>
                                            </Grid>

                                            <TextBlock Margin="2,18,0,8" Style="{StaticResource FieldLabel}" Text="{s:T split.ips}" />
                                            <ItemsControl x:Name="SplitNetworksList" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="SplitNetworkBox" MaxLength="50" KeyDown="SplitNetworkBox_KeyDown" Style="{StaticResource Field}" Tag="{s:T split.ipHint}" />
                                                <Button Grid.Column="1" Height="44" Margin="10,0,0,0" Padding="16,0" Click="SplitAddNetwork_Click" Style="{StaticResource SecondaryButton}">
                                                    <TextBlock FontSize="13" Text="{s:T split.add}" />
                                                </Button>
                                            </Grid>
                                            <TextBlock x:Name="SplitError" Margin="2,10,0,0" FontSize="12.5" Foreground="#FFA3AE" TextWrapping="Wrap" Visibility="Collapsed" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Rotating exit IP (panel: /me/rotation) -->
                                <Border x:Name="RotationCard" Margin="0,16,0,0" Padding="24" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="{s:T rotation.title}" />
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Small}" Text="{s:T rotation.hint}" TextWrapping="Wrap" />
                                        <Border Margin="0,16,0,0" Style="{StaticResource SegmentHost}">
                                            <UniformGrid x:Name="RotationIntervals" Rows="1" />
                                        </Border>
                                        <StackPanel x:Name="RotationCountriesPanel" Visibility="Collapsed">
                                            <TextBlock Margin="2,18,0,4" Style="{StaticResource FieldLabel}" Text="{s:T rotation.countries}" />
                                            <TextBlock Margin="2,0,0,8" Style="{StaticResource Small}" Text="{s:T rotation.countriesHint}" TextWrapping="Wrap" />
                                            <WrapPanel x:Name="RotationCountries" />
                                        </StackPanel>
                                        <TextBlock x:Name="RotationNote" Margin="2,10,0,0" FontSize="12.5" Foreground="#FFA3AE" TextWrapping="Wrap" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Padding="24" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="{s:T settings.language}" />
                                        <Border Margin="0,16,0,0" Style="{StaticResource SegmentHost}">
                                            <UniformGrid x:Name="SettingsLanguageList" Rows="1" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,16,0,0" Padding="24" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="{s:T settings.app}" />
                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock FontSize="14.5" FontWeight="Medium" Text="{s:T settings.startup}" />
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource Small}" Text="{s:T settings.startupHint}" />
                                            </StackPanel>
                                            <CheckBox x:Name="SettingsStartup" Grid.Column="1" Checked="Startup_Click" Style="{StaticResource Switch}" Unchecked="Startup_Click" />
                                        </Grid>
                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock FontSize="14.5" FontWeight="Medium" Text="{s:T settings.tray}" />
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource Small}" Text="{s:T settings.trayHint}" />
                                            </StackPanel>
                                            <CheckBox x:Name="SettingsTray" Grid.Column="1" Checked="Preference_Click" Style="{StaticResource Switch}" Unchecked="Preference_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,16,0,0" Padding="24" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource H2}" Text="{s:T settings.about}" />
                                                <TextBlock x:Name="VersionText" Margin="0,4,0,0" Style="{StaticResource Small}" />
                                            </StackPanel>
                                            <Button x:Name="CheckUpdatesButton" Height="38" Padding="16,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CheckUpdates_Click" Style="{StaticResource SecondaryButton}">
                                                <TextBlock x:Name="CheckUpdatesText" FontSize="13" Text="{s:T settings.checkUpdates}" />
                                            </Button>
                                        </Grid>
                                        <WrapPanel Margin="0,18,0,0">
                                            <Button Margin="0,0,18,6" Click="Website_Click" Content="{s:T settings.website}" Style="{StaticResource LinkButton}" />
                                            <Button Margin="0,0,18,6" Click="Privacy_Click" Content="{s:T settings.privacy}" Style="{StaticResource LinkButton}" />
                                            <Button Margin="0,0,18,6" Click="Terms_Click" Content="{s:T settings.terms}" Style="{StaticResource LinkButton}" />
                                            <Button Margin="0,0,18,6" Click="Logs_Click" Content="{s:T settings.logs}" Style="{StaticResource LinkButton}" />
                                        </WrapPanel>
                                        <!-- Open source: the app is GPL-3.0 on GitHub -->
                                        <Border Margin="0,14,0,0" Padding="16,14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Width="20" Height="20" Margin="0,0,14,0" VerticalAlignment="Center" Data="M8,7 L3,12 L8,17 M16,7 L21,12 L16,17 M13.5,4.5 L10.5,19.5" Stretch="Uniform" Stroke="{StaticResource AccentBrush}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2" />
                                                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="14.5" FontWeight="Medium" Text="{s:T about.openSource}" />
                                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Small}" Text="{s:T about.openSourceHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Height="36" Padding="14,0" VerticalAlignment="Center" Click="SourceCode_Click" Style="{StaticResource SecondaryButton}">
                                                    <TextBlock FontSize="13" Text="{s:T about.viewSource}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,9,0" Fill="{StaticResource AccentBrush}" />
                                            <TextBlock x:Name="CreditText" FontSize="12.5" Foreground="{StaticResource DimBrush}" />
                                        </StackPanel>
                                        <TextBlock Margin="15,6,0,0" FontSize="12" Foreground="{StaticResource DimBrush}" Text="{s:T about.credits}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Live support -->
                <Grid x:Name="SupportPage" Margin="44,4,40,26" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,20">
                        <StackPanel Margin="0,0,300,0">
                            <TextBlock Style="{StaticResource Kicker}" Text="{s:T support.kicker}" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource H1}" Text="{s:T support.title}" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}" Text="{s:T support.sub}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                            <Button Height="42" Margin="0,0,10,0" Padding="16,0" Click="SupportHelp_Click" Style="{StaticResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Margin="0,0,8,0" Data="{StaticResource IconBook}" Style="{StaticResource Stroke}" />
                                    <TextBlock FontSize="13.5" Text="{s:T support.help}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SupportNewButton" Height="42" Padding="18,0" Click="SupportNew_Click" Style="{StaticResource PrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="13" Height="13" Margin="0,0,8,0" Data="{StaticResource IconPlus}" Stretch="Uniform" Stroke="{StaticResource OnAccentBrush}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="2" />
                                    <TextBlock FontSize="13.5" Text="{s:T support.new}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="8" Style="{StaticResource Panel}">
                            <Grid>
                                <ListBox x:Name="SupportList" ItemTemplate="{StaticResource SupportRowTemplate}" SelectionChanged="SupportList_SelectionChanged" Style="{StaticResource PlainList}" />
                                <TextBlock x:Name="SupportListEmpty" Margin="18" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Small}" Text="{s:T support.empty}" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
                                <Ellipse x:Name="SupportListSpinner" Style="{StaticResource Spinner}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Padding="0" Style="{StaticResource Panel}">
                            <Grid>
                                <StackPanel x:Name="SupportPlaceholder" MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="64" Height="64">
                                        <Ellipse Fill="{StaticResource IconWellBrush}" Stroke="{StaticResource LineStrongBrush}" />
                                        <Path Width="26" Height="26" Data="{StaticResource IconChat}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                                    </Grid>
                                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Muted}" Text="{s:T support.pick}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <ScrollViewer x:Name="SupportNewForm" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel Margin="28,24,28,24">
                                        <TextBlock Style="{StaticResource H2}" Text="{s:T support.new}" />
                                        <TextBlock Margin="2,20,0,8" Style="{StaticResource FieldLabel}" Text="{s:T support.subject}" />
                                        <TextBox x:Name="SupportSubjectBox" MaxLength="160" Style="{StaticResource Field}" Tag="{s:T support.subjectHint}" />
                                        <TextBlock Margin="2,16,0,8" Style="{StaticResource FieldLabel}" Text="{s:T support.message}" />
                                        <TextBox x:Name="SupportMessageBox" MinHeight="140" MaxHeight="260" MaxLength="8000" Style="{StaticResource TextArea}" Tag="{s:T support.messageHint}" />
                                        <WrapPanel x:Name="SupportNewFiles" Margin="0,12,0,0" />
                                        <Grid Margin="0,6,0,0">
                                            <Button HorizontalAlignment="Left" Click="SupportAttachNew_Click" Style="{StaticResource LinkButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="14" Height="14" Margin="0,0,7,0" Data="{StaticResource IconClip}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeThickness="1.7" />
                                                    <TextBlock Text="{s:T support.attach}" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Small}" Text="{s:T support.attachHint}" />
                                        </Grid>
                                        <Border Margin="0,16,0,0" Padding="16,14" Style="{StaticResource Tile}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock FontSize="14" FontWeight="Medium" Text="{s:T support.diagnostics}" />
                                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Small}" Text="{s:T support.diagnosticsHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox x:Name="SupportDiagnostics" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="SupportErrorBox" Margin="0,16,0,0" Padding="14,10" Background="#1AFF6B7A" BorderBrush="#59FF6B7A" BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
                                            <TextBlock x:Name="SupportErrorText" FontSize="13" Foreground="#FFA3AE" TextWrapping="Wrap" />
                                        </Border>
                                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button Height="46" Margin="0,0,10,0" Padding="18,0" Click="SupportCancelNew_Click" Style="{StaticResource SecondaryButton}">
                                                <TextBlock FontSize="14" Text="{s:T support.cancel}" />
                                            </Button>
                                            <Button x:Name="SupportCreateButton" Height="46" Padding="22,0" Click="SupportCreate_Click" Style="{StaticResource PrimaryButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="SupportCreateSpinner" Margin="0,0,10,0" Stroke="{StaticResource OnAccentBrush}" Style="{StaticResource Spinner}" Visibility="Collapsed" />
                                                    <TextBlock FontSize="14" Text="{s:T support.create}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid x:Name="SupportThread" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Padding="24,18" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SupportThreadTitle" VerticalAlignment="Center" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <Border x:Name="SupportThreadStatus" Grid.Column="1" Margin="12,0,0,0" Padding="10,4" VerticalAlignment="Center" CornerRadius="9">
                                                <TextBlock x:Name="SupportThreadStatusText" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer x:Name="SupportScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="SupportMessages" Margin="24,18,24,10" />
                                    </ScrollViewer>
                                    <Border Grid.Row="2" Padding="16,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <WrapPanel x:Name="SupportReplyFiles" />
                                            <TextBlock x:Name="SupportClosedNote" Margin="4,0,0,0" Style="{StaticResource Small}" Text="{s:T support.closed}" Visibility="Collapsed" />
                                            <Grid x:Name="SupportComposer">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Margin="0,0,8,0" VerticalAlignment="Bottom" Click="SupportAttachReply_Click" Style="{StaticResource IconButton}" ToolTip="{s:T support.attach}">
                                                    <Path Data="{StaticResource IconClip}" Style="{StaticResource Stroke}" />
                                                </Button>
                                                <TextBox x:Name="SupportReplyBox" Grid.Column="1" MinHeight="48" MaxHeight="150" MaxLength="8000" PreviewKeyDown="SupportReply_PreviewKeyDown" Style="{StaticResource TextArea}" Tag="{s:T support.reply}" />
                                                <Button x:Name="SupportSendButton" Grid.Column="2" Width="48" Height="48" Margin="10,0,0,0" Padding="0" VerticalAlignment="Bottom" Click="SupportSend_Click" Style="{StaticResource PrimaryButton}" ToolTip="{s:T support.send}">
                                                    <Grid>
                                                        <Path x:Name="SupportSendIcon" Width="17" Height="17" Data="{StaticResource IconSend}" Stretch="Uniform" Stroke="{StaticResource OnAccentBrush}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2" />
                                                        <Ellipse x:Name="SupportSendSpinner" Stroke="{StaticResource OnAccentBrush}" Style="{StaticResource Spinner}" Visibility="Collapsed" />
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ── Russian sites outside the tunnel: one-time notice after the first such connection ── -->
        <Grid x:Name="RuDirectNotice" Background="#B3050508" Visibility="Collapsed">
            <Border Width="480" Padding="34,32" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid Width="56" Height="56" HorizontalAlignment="Left">
                        <Ellipse Fill="{StaticResource IconWellBrush}" Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1" />
                        <Path Width="22" Height="22" Data="{StaticResource IconShield}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                    </Grid>
                    <TextBlock Margin="0,20,0,0" Style="{StaticResource H2}" Text="{s:T privacy.notice.title}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}" Text="{s:T privacy.notice.body}" TextWrapping="Wrap" />
                    <Button Margin="0,12,0,0" HorizontalAlignment="Left" Click="PrivacyScope_Click" Content="{s:T privacy.details}" Style="{StaticResource LinkButton}" />
                    <Button Height="50" Margin="0,20,0,0" HorizontalAlignment="Stretch" Click="RuDirectNoticeKeep_Click" Style="{StaticResource PrimaryButton}">
                        <TextBlock FontSize="15" Text="{s:T privacy.notice.keep}" />
                    </Button>
                    <Button Height="46" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="RuDirectNoticeEnable_Click" Content="{s:T privacy.notice.enable}" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── This device is paused by the plan's device limit ──────────────── -->
        <Grid x:Name="PausedPrompt" Background="#B3050508" Visibility="Collapsed">
            <Border Width="480" Padding="34,32" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid Width="56" Height="56" HorizontalAlignment="Left">
                        <Ellipse Fill="{StaticResource IconWellBrush}" Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1" />
                        <Path Width="22" Height="22" Data="{StaticResource IconDevice}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                    </Grid>
                    <TextBlock Margin="0,20,0,0" Style="{StaticResource Kicker}" Text="{s:T paused.kicker}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource H2}" Text="{s:T paused.title}" TextWrapping="Wrap" />
                    <TextBlock x:Name="PausedBody" Margin="0,10,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    <Border x:Name="PausedErrorBox" Margin="0,14,0,0" Padding="14,10" Background="#1AFF6B7A" BorderBrush="#59FF6B7A" BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
                        <TextBlock x:Name="PausedErrorText" FontSize="13" Foreground="#FFA3AE" TextWrapping="Wrap" />
                    </Border>
                    <Button x:Name="PausedUseThisButton" Height="50" Margin="0,22,0,0" HorizontalAlignment="Stretch" Click="PausedUseThis_Click" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PausedSpinner" Margin="0,0,10,0" Stroke="{StaticResource OnAccentBrush}" Style="{StaticResource Spinner}" Visibility="Collapsed" />
                            <TextBlock FontSize="15" Text="{s:T paused.useThis}" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="PausedUseThisHint" Margin="2,8,0,0" Style="{StaticResource Small}" Text="{s:T paused.useThisHint}" TextWrapping="Wrap" />
                    <Button Height="46" Margin="0,14,0,0" HorizontalAlignment="Stretch" Click="PausedPremium_Click" Content="{s:T paused.premium}" Style="{StaticResource SecondaryButton}" />
                    <Button Margin="0,14,0,0" HorizontalAlignment="Left" Click="PausedSignOut_Click" Content="{s:T paused.signOut}" Style="{StaticResource LinkButton}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Proxy-mode users from before 2.6.0: asked once about TUN mode ── -->
        <Grid x:Name="TunPrompt" Background="#B3050508" Visibility="Collapsed">
            <Border Width="480" Padding="34,32" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid Width="56" Height="56" HorizontalAlignment="Left">
                        <Ellipse Fill="{StaticResource IconWellBrush}" Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1" />
                        <Path Width="22" Height="22" Data="{StaticResource IconShield}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                    </Grid>
                    <TextBlock Margin="0,20,0,0" Style="{StaticResource H2}" Text="{s:T tun.prompt.title}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}" Text="{s:T tun.prompt.body}" TextWrapping="Wrap" />
                    <Button Height="50" Margin="0,22,0,0" HorizontalAlignment="Stretch" Click="TunPromptSwitch_Click" Style="{StaticResource PrimaryButton}">
                        <TextBlock FontSize="15" Text="{s:T tun.prompt.switch}" />
                    </Button>
                    <Button Height="46" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="TunPromptKeep_Click" Content="{s:T tun.prompt.keep}" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Update prompt (on start, over every screen) ───────────────────── -->
        <Grid x:Name="UpdatePrompt" Background="#B3050508" Visibility="Collapsed">
            <Border Width="440" Padding="34,32" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid Width="56" Height="56" HorizontalAlignment="Left">
                        <Ellipse Fill="{StaticResource IconWellBrush}" Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1" />
                        <Path Width="22" Height="22" Data="{StaticResource IconDownload}" Stretch="Uniform" Stroke="{StaticResource LilacBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                    </Grid>
                    <TextBlock x:Name="UpdatePromptTitle" Margin="0,20,0,0" Style="{StaticResource H2}" TextWrapping="Wrap" />
                    <TextBlock x:Name="UpdatePromptBody" Margin="0,10,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    <TextBlock x:Name="UpdatePromptStatus" Margin="0,14,0,0" Style="{StaticResource Small}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <Button x:Name="UpdatePromptNow" Height="50" Margin="0,22,0,0" HorizontalAlignment="Stretch" Click="UpdatePromptNow_Click" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="UpdatePromptSpinner" Margin="0,0,10,0" Stroke="{StaticResource OnAccentBrush}" Style="{StaticResource Spinner}" Visibility="Collapsed" />
                            <TextBlock x:Name="UpdatePromptNowText" FontSize="15" Text="{s:T update.now}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="UpdatePromptLater" Height="46" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="UpdatePromptLater_Click" Content="{s:T update.later}" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Window controls (always on top) -->
        <StackPanel Margin="0,15,16,0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
            <!-- Live support, with the unread badge; only while signed in. -->
            <Button x:Name="SupportLauncher" Margin="0,0,6,0" Click="SupportLauncher_Click" RenderTransformOrigin="0.5,0.5" Style="{StaticResource WindowButton}" ToolTip="{s:T support.title}" Visibility="Collapsed">
                <Button.RenderTransform>
                    <ScaleTransform x:Name="SupportLauncherScale" />
                </Button.RenderTransform>
                <Grid Width="34" Height="34">
                    <Path Width="15" Height="15" Data="{StaticResource IconChat}" Style="{StaticResource Stroke}" />
                    <Border x:Name="SupportBadge" MinWidth="16" Height="16" Margin="0,1,0,0" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource DangerBrush}" BorderBrush="#0E0E14" BorderThickness="1.5" CornerRadius="8" Visibility="Collapsed">
                        <TextBlock x:Name="SupportBadgeText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Grid>
            </Button>
            <Button Click="Minimize_Click" Style="{StaticResource WindowButton}" ToolTip="{s:T window.minimize}">
                <Path Width="12" Height="12" Data="{StaticResource IconMinus}" Style="{StaticResource Stroke}" />
            </Button>
            <Button Margin="6,0,0,0" Click="Close_Click" Style="{StaticResource WindowCloseButton}" ToolTip="{s:T window.close}">
                <Path Width="11" Height="11" Data="{StaticResource IconX}" Style="{StaticResource Stroke}" />
            </Button>
        </StackPanel>

        <!-- Toast -->
        <Border x:Name="Toast" Margin="0,0,0,28" MaxWidth="560" Padding="18,12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="#F21B1B24" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="20" IsHitTestVisible="False" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="20" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Opacity="0.6" ShadowDepth="12" Direction="270" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ToastDot" Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{StaticResource LilacBrush}" />
                <TextBlock x:Name="ToastText" MaxWidth="500" FontSize="13.5" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
